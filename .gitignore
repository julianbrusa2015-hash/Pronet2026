.claude/settings.local.json
.claude/scheduled_tasks.lock
node_modules/
test-results/
playwright-report/
tests/.auth/
# Cualquier .env — .env.staging lleva la SERVICE_ROLE_KEY, que saltea
# toda la RLS. Un `git add .` sin este patrón la publicaría en el repo.
.env
.env.*
!.env.example
supabase/.temp/

# Capacitor: www/ es una copia generada del código de la raíz (ver
# scripts/sync-www.js), no una fuente propia — no versionar.
www/

# Generados en build o locales — no versionar
styles.min.css
config-secrets.js

# Firma de release de Android: si esto se pierde o se filtra, no se puede
# volver a actualizar la app en Play Store nunca más. Guardar el .jks y
# las contraseñas fuera del repo, en un lugar seguro y con backup.
android/*.jks
android/keystore.properties
android/google-services.json

# Imágenes de ejemplo del carrusel: se generan con scripts/gen-banners-demo.mjs
# y se suben a Storage. No tiene sentido versionar 1,3 MB de placeholders.
iconos/banners-demo/

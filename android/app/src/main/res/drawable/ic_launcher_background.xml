<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del ícono adaptativo: el degradado de marca de la app.
     Antes era @color/ic_launcher_background, un blanco plano heredado del
     ícono por defecto de Capacitor.

     Va como vector drawable y no como PNG para que no haya que generar cinco
     densidades de un degradado. Los gradientes en vector drawable existen
     desde API 24, que es justo el minSdk del proyecto.

     Los tres stops son los mismos de iconos/pronet-isotipo-red.svg. Si cambia
     el degradado de marca, hay que tocar los dos. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="67"
                android:endY="108">
                <item android:offset="0" android:color="#FF0D0F1A"/>
                <item android:offset="0.6" android:color="#FF1A3ACC"/>
                <item android:offset="1" android:color="#FF2B5BFF"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
